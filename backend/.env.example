# Configuración del backend (copia este archivo a .env y ajusta si lo necesitas)

# --- Seguridad / JWT ---
JWT_SECRET=Clave
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Base de datos (SQLite por defecto) ---
DATABASE_URL=sqlite:///./practica2.db

# --- Carpeta de subida de imágenes de producto ---
UPLOAD_DIR=uploads

# --- Servidor ---
PORT=3000

# --- CORS: "*" o lista separada por comas (p. ej. http://localhost:5173) ---
CORS_ORIGINS=*
